{
  "expo": {
    "name": "Kite Ledger",
    "slug": "kite-ledger-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "kiteledgermobile",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#06130e"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tharun007.kiteledgermobile"
    },
    "android": {
      "package": "com.tharun007.kiteledgermobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#06130e"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "70b9fe45-3c66-4320-ac91-9c8949773b79"
      }
    },
    "owner": "tharun_007"
  }
}